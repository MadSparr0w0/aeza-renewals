# Generate .env using python scripts/init_env.py; never commit real secrets.
ADMIN_USERNAME=admin
# scrypt$16384$8$5$<32 hex salt>$<128 hex hash>, quoted for Docker Compose.
ADMIN_PASSWORD_HASH=''
# Random 32+ characters. Generated automatically by init_env.py.
APP_SECRET=''
APP_ORIGIN=http://127.0.0.1:8000
# Optional explicit browser origins, comma-separated; use only for development.
APP_ALLOWED_ORIGINS=
TIMEZONE=Europe/Moscow
DATABASE_PATH=data/invoice_keeper.db
# Production HTTPS requires true.
COOKIE_SECURE=false
SESSION_HOURS=12
# Telegram bot: no network sends until BOTH values are configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional explicit 12+ char demo password used ONLY by python -m backend.seed.
DEMO_USER_PASSWORD=''
