[Unit]
Description=Aeza regular payments HTTP API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=aeza-renewals
Group=aeza-renewals
WorkingDirectory=/opt/aeza-renewals/current
EnvironmentFile=/etc/aeza-renewals/environment
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
Environment=PYTHONDONTWRITEBYTECODE=1
# The reverse proxy must overwrite forwarded headers. Only its loopback peer
# is trusted; the application socket must never be published externally.
ExecStart=/opt/aeza-renewals/current/.venv/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 8000 --no-access-log --proxy-headers --forwarded-allow-ips=127.0.0.1 --timeout-graceful-shutdown=30
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=45s

StateDirectory=aeza-renewals
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/aeza-renewals
ReadWritePaths=/var/lib/aeza-renewals

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aeza-renewals-api

[Install]
WantedBy=multi-user.target
