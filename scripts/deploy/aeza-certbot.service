[Unit]
Description=Renew Aeza test server TLS certificate
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/aeza-certbot/bin/certbot renew --quiet --deploy-hook "/usr/sbin/nginx -s reload"
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
